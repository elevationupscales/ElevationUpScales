+
+function ebayDecodeHtml(value) {
+  return String(value || "")
+    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(Number.parseInt(hex, 16)))
+    .replace(/&#(\d+);/g, (_, num) => String.fromCodePoint(Number.parseInt(num, 10)))
+    .replace(/&quot;/gi, '"')
+    .replace(/&#39;|&apos;/gi, "'")
+    .replace(/&amp;/gi, "&")
+    .replace(/&lt;/gi, "<")
+    .replace(/&gt;/gi, ">")
+    .replace(/&nbsp;/gi, " ");
+}
+
+function ebayPlainText(value, max = 240) {
+  return cleanString(ebayDecodeHtml(String(value || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ")), max);
+}
+
+function ebayLegacyItemId(value) {
+  const raw = String(value || "");
+  const restMatch = raw.match(/^v1\|(\d{9,15})\|/i);
+  if (restMatch) return restMatch[1];
+  const urlMatch = raw.match(/\/itm\/(?:[^/?#]+\/)?(\d{9,15})(?:[/?#]|$)/i);
+  if (urlMatch) return urlMatch[1];
+  const direct = raw.match(/\b(\d{9,15})\b/);
+  return direct ? direct[1] : "";
+}
+
+function ebaySafeItemUrl(value) {
+  try {
+    const url = new URL(String(value || ""), "https://www.ebay.com");
+    const host = url.hostname.toLowerCase();
+    if (url.protocol !== "https:" || (host !== "ebay.com" && host !== "www.ebay.com")) return "";
+    return url.toString();
+  } catch (_) {
+    return "";
+  }
+}
+
+function ebaySafeImageUrl(value) {
+  try {
+    const url = new URL(String(value || ""));
+    const host = url.hostname.toLowerCase();
+    if (url.protocol !== "https:" || !(host === "ebayimg.com" || host.endsWith(".ebayimg.com") || host === "ebaystatic.com" || host.endsWith(".ebaystatic.com"))) return "";
+    return url.toString();
+  } catch (_) {
+    return "";
+  }
+}
+
+function ebayMoneyCents(value) {
+  const number = Number(String(value ?? "").replace(/[^0-9.-]/g, ""));
+  return Number.isFinite(number) && number >= 0 ? Math.round(number * 100) : 0;
+}
+
+function ebayCategoryFromTitle(title) {
+  const text = String(title || "").toLowerCase();
+  if (/\b(rv|camper|motorhome|motor home|travel trailer|fifth wheel|5th wheel|tow|towing|hitch|awning|water pump|fresh water|black water|sewer|propane|leveling|stabilizer|roof vent|slide.?out|refrigerator|converter|shore power)\b/.test(text)) return "RV Parts & Accessories";
+  if (/\b(solar|battery|inverter|charge controller|power station|generator|12v|24v|48v|off.?grid)\b/.test(text)) return "Solar & Off-Grid";
+  if (/\b(camp|camping|outdoor|hiking|tent|lantern|cooler|camp chair|sleeping bag|picnic)\b/.test(text)) return "Camping & Outdoor";
+  return "RV & Outdoor";
+}
+
+function ebaySyncMeta(notes) {
+  try {
+    const parsed = JSON.parse(String(notes || "{}"));
+    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : {};
+  } catch (_) {
+    return {};
+  }
+}
+
+function ebaySyncNotes(listing, source) {
+  return JSON.stringify({
+    managedBy: EBAY_SYNC_MANAGED_BY,
+    seller: EBAY_SYNC_SELLER,
+    source,
+    imageUrl: ebaySafeImageUrl(listing.imageUrl),
+  });
+}
+
+function ebayListingCandidate({ id, title, price, url, imageUrl }) {
+  const itemUrl = ebaySafeItemUrl(url);
+  const itemId = ebayLegacyItemId(id || itemUrl);
+  const name = ebayPlainText(title, 180);
+  if (!itemId || !name || !itemUrl) return null;
+  return {
+    id: itemId,
+    name,
+    priceCents: ebayMoneyCents(price),
+    url: itemUrl,
+    imageUrl: ebaySafeImageUrl(imageUrl),
+  };
+}
+
+function ebayCollectJsonLd(node, listings, depth = 0) {
+  if (!node || depth > 10 || listings.size >= 500) return;
+  if (Array.isArray(node)) {
+    for (const value of node) ebayCollectJsonLd(value, listings, depth + 1);
+    return;
+  }
+  if (typeof node !== "object") return;
+  const item = node.item && typeof node.item === "object" ? node.item : node;
+  const offer = Array.isArray(item.offers) ? item.offers[0] : (item.offers || {});
+  const image = Array.isArray(item.image) ? item.image[0] : item.image;
+  const imageUrl = typeof image === "string" ? image : image?.url;
+  const candidate = ebayListingCandidate({
+    id: item.itemId || item.sku || "",
+    title: item.name || item.title || "",
+    price: offer?.price ?? offer?.lowPrice ?? "",
+    url: item.url || "",
+    imageUrl,
+  });
+  if (candidate) listings.set(candidate.id, candidate);
+  for (const value of Object.values(node)) ebayCollectJsonLd(value, listings, depth + 1);
+}
+
+function ebayListingsFromHtml(html) {
+  const source = String(html || "");
+  const listings = new Map();
+  for (const match of source.matchAll(/<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi)) {
+    try { ebayCollectJsonLd(JSON.parse(ebayDecodeHtml(match[1])), listings); } catch (_) {}
+  }
+  const linkPattern = /href=["'](https:\/\/www\.ebay\.com\/itm\/[^"'<>]+|\/itm\/[^"'<>]+)["']/gi;
+  for (const match of source.matchAll(linkPattern)) {
+    const itemUrl = ebaySafeItemUrl(match[1]);
+    const id = ebayLegacyItemId(itemUrl);
+    if (!id || listings.has(id)) continue;
+    const start = Math.max(0, (match.index || 0) - 1200);
+    const end = Math.min(source.length, (match.index || 0) + 6500);
+    const window = source.slice(start, end);
+    const titleMatch = window.match(/class=["'][^"']*s-item__title[^"']*["'][^>]*>([\s\S]{0,600}?)<\/[^>]+>/i)
+      || window.match(/(?:title|aria-label)=["']([^"']{4,220})["']/i);
+    const priceMatch = window.match(/class=["'][^"']*s-item__price[^"']*["'][^>]*>([\s\S]{0,160}?)<\/[^>]+>/i);
+    const imageMatch = window.match(/(?:src|data-src)=["'](https:\/\/[^"']*(?:ebayimg|ebaystatic)\.com\/[^"']+)["']/i);
+    const candidate = ebayListingCandidate({
+      id,
+      title: titleMatch?.[1] || "",
+      price: ebayPlainText(priceMatch?.[1] || "", 80),
+      url: itemUrl,
+      imageUrl: imageMatch?.[1] || "",
+    });
+    if (candidate) listings.set(candidate.id, candidate);
+  }
+  return [...listings.values()];
+}
