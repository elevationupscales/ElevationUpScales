{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card .group-block > * {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
    border: 1px solid #dbe1dd;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 8px 24px rgb(15 33 53 / 5%);
  }

  :is(.product-grid__item, .resource-list__item) product-price {
    color: #0f2135;
    font-weight: 900;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  .eus-card-buy-now-form {
    position: relative;
    z-index: 3;
    width: 100%;
    margin: 0;
  }

  .eus-card-buy-now {
    width: 100%;
    min-height: 46px;
    border: 0;
    border-radius: 10px;
    padding: 12px 16px;
    background: #0f2135;
    color: #fff;
    font: inherit;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 5px 14px rgb(15 33 53 / 16%);
  }

  .eus-card-buy-now:hover {
    background: #2f624b;
  }

  .eus-card-buy-now:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .eus-card-actions {
    position: relative;
    z-index: 3;
    width: 100%;
    margin-top: auto;
    padding: 0 12px 14px;
  }

  .eus-card-choose-options {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    border: 1px solid #2f624b;
    border-radius: 10px;
    padding: 11px 14px;
    background: #2f624b;
    color: #fff;
    text-decoration: none;
    font: inherit;
    font-weight: 900;
    text-align: center;
    box-shadow: 0 5px 14px rgb(47 98 75 / 18%);
  }

  .eus-card-choose-options:hover {
    background: #244f3c;
    border-color: #244f3c;
  }

  .eus-card-choose-options:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .eus-card-choose-options--unavailable {
    border-color: #9aa5ad;
    color: #53616b;
  }

  @media screen and (max-width: 749px) {
    .eus-card-actions {
      padding: 0 8px 10px;
    }

    .eus-card-buy-now,
    .eus-card-choose-options {
      min-height: 42px;
      padding-inline: 10px;
      font-size: .82rem;
    }
  }

{% endstylesheet %}
