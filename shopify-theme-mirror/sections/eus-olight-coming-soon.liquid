{% if collection.handle == 'olight' or collection.handle == 'olight-tactical-professional-lighting' %}
{% assign is_tactical = false %}
{% if collection.handle == 'olight-tactical-professional-lighting' %}{% assign is_tactical = true %}{% endif %}
<section class="eus-olight-destination{% if is_tactical %} eus-olight-destination--tactical{% endif %}" aria-label="Olight">
  {% assign hero_video = blank %}
  {% if is_tactical %}
    {% assign hero_image = 'https://cdn.shopify.com/s/files/1/1035/5353/2273/files/01_OSIGHT_R_Outdoor_Long_Range_2520c3ad-d433-430d-ae34-77f783501001.jpg?v=1790122780' %}
    {% assign hero_alt = 'Olight OSIGHT R in an outdoor long-range setup' %}
    {% assign eyebrow = 'OLIGHT TACTICAL & PROFESSIONAL' %}
    {% assign headline = 'Ready When It Matters.' %}
    {% assign subcopy = 'Purpose-built Olight lighting and optics for demanding outdoor, property, work and professional applications.' %}
  {% else %}
    {% assign hero_image = 'https://cdn.shopify.com/s/files/1/1035/5353/2273/files/2R8A0200_e72d2856-72e2-4cc0-82f0-28ca4a6980eb.jpg?v=1790107803' %}
    {% assign hero_video = 'https://cdn.shopify.com/videos/c/o/v/1c899e67ef154741adcc3351562e957b.mp4' %}
    {% assign hero_alt = 'Olight dust and waterproof durability demonstration' %}
    {% assign eyebrow = 'AUTHORIZED OLIGHT DEALER' %}
    {% assign headline = 'Find Your Light.' %}
    {% assign subcopy = 'Explore dependable Olight illumination for everyday carry, outdoor adventures, property, work, travel and the moments when light matters.' %}
  {% endif %}

  <div class="eus-olight-destination__hero">
    {% if hero_video != blank %}
      <video autoplay muted loop playsinline preload="metadata" poster="{{ hero_image }}" aria-label="{{ hero_alt }}">
        <source src="{{ hero_video }}" type="video/mp4">
      </video>
    {% else %}
      <img src="{{ hero_image }}&width=2200" alt="{{ hero_alt }}" loading="eager" fetchpriority="high" width="2200" height="1031">
    {% endif %}
    <div class="eus-olight-destination__hero-shade"></div>
    <div class="eus-olight-destination__hero-copy page-width">
      <span class="eus-olight-destination__eyebrow">{{ eyebrow }}</span>
      <h1>{{ headline }}</h1>
      <p>{{ subcopy }}</p>
      <div class="eus-olight-destination__actions">
        <a class="eus-olight-destination__button eus-olight-destination__button--primary" href="#olight-products">Shop Olight</a>
        {% if is_tactical %}
          <a class="eus-olight-destination__button" href="/collections/olight">Explore All Olight</a>
        {% else %}
          <a class="eus-olight-destination__button" href="/collections/olight-tactical-professional-lighting">Tactical &amp; Professional</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="eus-olight-destination__trust page-width">
    <div><strong>Authorized Olight Dealer</strong><span>Official Olight products through Elevation UpScales</span></div>
    <div><strong>Built for the Outdoors</strong><span>Lighting for travel, property, work and exploration</span></div>
    <div><strong>Elevation Support</strong><span>U.S.-based retailer support before and after purchase</span></div>
  </div>

  {% unless is_tactical %}
  <div class="eus-olight-destination__intro page-width">
    <div>
      <span class="eus-olight-destination__eyebrow">ILLUMINATE YOUR WORLD</span>
      <h2>Light for the places you go and the work you do.</h2>
    </div>
    <p>From long-range handhelds and rugged everyday lights to professional optics, Elevation UpScales brings Olight into a broader equipment lineup built around outdoor, off-grid and property use.</p>
  </div>

  <div class="eus-olight-destination__paths page-width">
    <a class="eus-olight-path" href="/products/olight-warrior-ultra-2-500-lumen-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/2R8A9785_80be1376-5bb9-4cb2-ae4c-6f9a6a247aab.jpg?v=1790107802&width=1000" alt="Olight Warrior Ultra color lineup" loading="lazy" width="1000" height="667">
      <span class="eus-olight-path__shade"></span>
      <span class="eus-olight-path__copy"><small>EVERYDAY ILLUMINATION</small><strong>Warrior Ultra</strong><em>Shop the lineup →</em></span>
    </a>
    <a class="eus-olight-path" href="/products/olight-javelot-turbo-2-1-800-lumen-long-range-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/03_Javelot_Turbo_2_1500m_Beam_336579a7-ef2b-4900-90c3-ef695f48f76b.jpg?v=1790101953&width=1000" alt="Olight Javelot Turbo 2 long-range beam" loading="lazy" width="1000" height="667">
      <span class="eus-olight-path__shade"></span>
      <span class="eus-olight-path__copy"><small>CONQUER THE NIGHT</small><strong>Long-Range Lighting</strong><em>Explore Javelot Turbo 2 →</em></span>
    </a>
    <a class="eus-olight-path" href="/products/olight-osight-r-enclosed-red-dot-sight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/olight-osight-r-lifestyle-mounted-optic.jpg?v=1790121568&width=1000" alt="Olight OSIGHT R mounted outdoors" loading="lazy" width="1000" height="667">
      <span class="eus-olight-path__shade"></span>
      <span class="eus-olight-path__copy"><small>READY WHEN IT MATTERS</small><strong>OSIGHT Optics</strong><em>Explore OSIGHT R →</em></span>
    </a>
  </div>

  <section class="eus-olight-new page-width" aria-label="New from Olight">
    <a class="eus-olight-new__media" href="/pages/olight-pl-x-gl-gallery" aria-label="Explore the Olight PL X GL product gallery">
      <video autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source src="https://cdn.shopify.com/videos/c/o/v/5d7e43c2074046168042ce8157002fe2.mp4" type="video/mp4">
      </video>
      <span class="eus-olight-new__shade"></span>
      <span class="eus-olight-new__media-copy">
        <small>NEW FROM OLIGHT</small>
        <strong>PL X GL</strong>
        <em>Explore the product gallery →</em>
      </span>
    </a>
    <div class="eus-olight-new__copy">
      <span class="eus-olight-destination__eyebrow">PRODUCT GALLERY</span>
      <h2>Go beyond the listing.</h2>
      <p>Explore the complete PL X GL image set, 3D breakdown, feature graphics and specifications in one dedicated product gallery.</p>
      <a class="eus-olight-destination__button eus-olight-destination__button--primary" href="/pages/olight-pl-x-gl-gallery">Explore PL X GL</a>
    </div>
  </section>

  {% assign osight_r = all_products['olight-osight-r-enclosed-red-dot-sight'] %}
  {% if osight_r != blank %}
  {% assign osight_r_variant = osight_r.selected_or_first_available_variant %}
  <section class="eus-olight-osr page-width" aria-label="Featured Olight OSIGHT R">
    <div class="eus-olight-osr__copy">
      <span class="eus-olight-destination__eyebrow">FEATURED OPTICS</span>
      <h2>OSIGHT R, in motion.</h2>
      <p>See the OSIGHT R before you shop it. This feature brings Olight's launch media together with current retail pricing and a direct path to the product listing.</p>
      <div class="eus-olight-osr__retail">
        <strong>{{ osight_r_variant.price | money }}</strong>
        {% if osight_r_variant.available %}
          <span>Available to order</span>
        {% else %}
          <span>Check availability</span>
        {% endif %}
      </div>
      <div class="eus-olight-osr__actions">
        {% if osight_r_variant.available %}
          {% form 'product', osight_r, class: 'eus-olight-osr__buy-form' %}
            <input type="hidden" name="id" value="{{ osight_r_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" name="checkout" class="eus-olight-destination__button eus-olight-destination__button--primary eus-olight-osr__buy-now">Buy OSIGHT R now</button>
          {% endform %}
        {% endif %}
        <a class="eus-olight-destination__button" href="{{ osight_r.url }}">View OSIGHT R</a>
        <a class="eus-olight-osr__secondary" href="/pages/olight-osight-r-gallery">Explore the OSIGHT R profile →</a>
      </div>
    </div>

    <div class="eus-olight-osr__media">
      <video controls muted playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/11_OSIGHT_R_Ready_When_It_Matters_b7f8b790-a3d6-4862-858a-77b0e140a2cd.jpg?v=1790110309">
        <source src="https://cdn.shopify.com/videos/c/o/v/bfe377f92ca44a74b28dce9185232e68.mp4" type="video/mp4">
      </video>
      <div class="eus-olight-osr__media-meta">
        <span>NEW FROM OLIGHT</span>
        <strong>OSIGHT R</strong>
        <em>51-second promotional feature</em>
      </div>
    </div>
  </section>
  {% endif %}
  {% endunless %}

  {% if is_tactical %}
  {% assign tactical_osight = all_products['olight-osight-r-enclosed-red-dot-sight'] %}
  {% assign tactical_osight_variant = tactical_osight.selected_or_first_available_variant %}
  <div class="eus-olight-destination__intro page-width">
    <div>
      <span class="eus-olight-destination__eyebrow">TACTICAL &amp; PROFESSIONAL</span>
      <h2>Professional lighting and optics, shown in motion.</h2>
    </div>
    <p>Explore Olight's professional lineup through product video, operating demonstrations and installation content before moving into the current collection.</p>
  </div>

  <section class="eus-tactical-video-hub page-width" aria-label="Olight tactical video features">
    <div class="eus-tactical-video-hub__lead">
      <video controls muted playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/11_OSIGHT_R_Ready_When_It_Matters_b7f8b790-a3d6-4862-858a-77b0e140a2cd.jpg?v=1790110309">
        <source src="https://cdn.shopify.com/videos/c/o/v/bfe377f92ca44a74b28dce9185232e68.mp4" type="video/mp4">
      </video>
      <div class="eus-tactical-video-hub__lead-copy">
        <span class="eus-olight-destination__eyebrow">FEATURED OPTICS</span>
        <h2>OSIGHT R campaign feature.</h2>
        <p>Start with the released OSIGHT R promotional film, then move into the operating and mounting demonstrations below.</p>
        {% if tactical_osight != blank %}
          <div class="eus-tactical-video-hub__retail">
            <strong>{{ tactical_osight_variant.price | money }}</strong>
            {% if tactical_osight_variant.available %}<span>Available to order</span>{% else %}<span>Check availability</span>{% endif %}
          </div>
          <a class="eus-olight-destination__button eus-olight-destination__button--primary" href="{{ tactical_osight.url }}">Shop OSIGHT R</a>
        {% endif %}
      </div>
    </div>

    <div class="eus-tactical-video-hub__grid">
      <article class="eus-tactical-video-card">
        <video controls muted playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/04_OSIGHT_R_NV_Control_Side_589ad7a6-7246-463a-a168-d5118dd6b5f6.jpg?v=1790110310">
          <source src="https://cdn.shopify.com/videos/c/o/v/8f6941e0091c4d49b79f24eb8553e7ef.mp4" type="video/mp4">
        </video>
        <div><span>OSIGHT R</span><strong>Operation</strong><em>Controls, settings and product use</em></div>
      </article>
      <article class="eus-tactical-video-card">
        <video controls muted playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/08_OSIGHT_R_ARD_View_a5f5b317-0c54-4f0c-98e8-16ddb1ca2eeb.jpg?v=1790110310">
          <source src="https://cdn.shopify.com/videos/c/o/v/7cc7977b4d7b43ef89866fc8e2027cc1.mp4" type="video/mp4">
        </video>
        <div><span>OSIGHT R</span><strong>Mounts &amp; ARD Installation</strong><em>Mounting and accessory setup</em></div>
      </article>
    </div>
  </section>

  <div class="eus-olight-destination__tactical-feature page-width">
    <a href="/products/olight-warrior-x-4-2-600-lumen-long-throw-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/02_Warrior_X4_Performance_2600lm_630m.jpg?v=1790091800&width=1300" alt="Olight Warrior X 4 2600 lumen 630 meter performance" loading="lazy" width="1300" height="609">
      <span><small>LONG-RANGE LIGHTING</small><strong>Warrior X 4</strong><em>2,600 lumens · 630 m throw →</em></span>
    </a>
    <a href="/products/olight-osight-r-enclosed-red-dot-sight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/08_OSIGHT_R_Studio_Action_1ca732eb-467e-453a-9fbf-f4a0250d912e.jpg?v=1790122779&width=1300" alt="Olight OSIGHT R studio action scene" loading="lazy" width="1300" height="867">
      <span><small>PROFESSIONAL OPTICS</small><strong>OSIGHT R</strong><em>Enclosed multi-reticle optic →</em></span>
    </a>
  </div>
  {% endif %}

  <div class="eus-olight-destination__gallery-head page-width">
    <div>
      <span class="eus-olight-destination__eyebrow">{% if is_tactical %}READY WHEN IT MATTERS{% else %}LIGHT UP EVERY ADVENTURE{% endif %}</span>
      <h2>{% if is_tactical %}Professional lighting and optics in focus.{% else %}Explore Olight in action.{% endif %}</h2>
    </div>
    <p>Choose a scene to shop the featured product or explore the related Olight collection.</p>
  </div>

  <div class="eus-olight-destination__gallery page-width">
    <a class="eus-olight-gallery-card eus-olight-gallery-card--wide" href="/products/olight-warrior-ultra-2-500-lumen-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/2R8A9832_662f0910-3435-477e-854d-016fa4bc60b3.jpg?v=1790107803&width=1400" alt="Olight Warrior Ultra illuminating a wooded trail at night" loading="lazy" width="1400" height="933">
      <span>Built for the Outdoors <b>Warrior Ultra →</b></span>
    </a>
    <a class="eus-olight-gallery-card" href="/products/olight-warrior-ultra-2-500-lumen-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/2R8A0778_1f3e7ee7-fad0-4411-ab6f-afc1341a5e0d.jpg?v=1790107803&width=900" alt="Olight Warrior Ultra waterproof durability demonstration" loading="lazy" width="900" height="600">
      <span>Ready for the Elements <b>Warrior Ultra →</b></span>
    </a>
    <a class="eus-olight-gallery-card" href="/products/olight-warrior-x-4-2-600-lumen-long-throw-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/02_Warrior_X4_Performance_2600lm_630m.jpg?v=1790091800&width=900" alt="Olight Warrior X 4 beam performance" loading="lazy" width="900" height="422">
      <span>Go the Distance <b>Warrior X 4 →</b></span>
    </a>
    <a class="eus-olight-gallery-card" href="/products/olight-warrior-x-4-2-600-lumen-long-throw-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/olight-warrior-x4-tail-switch_2cf1ba54-d963-416c-a183-e1e29199ac64.jpg?v=1790093377&width=900" alt="Olight Warrior X 4 tail switch and charging interface" loading="lazy" width="900" height="600">
      <span>Fast Control <b>Warrior X 4 →</b></span>
    </a>
    <a class="eus-olight-gallery-card eus-olight-gallery-card--wide" href="/products/olight-javelot-turbo-2-1-800-lumen-long-range-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/03_Javelot_Turbo_2_1500m_Beam_336579a7-ef2b-4900-90c3-ef695f48f76b.jpg?v=1790101953&width=1400" alt="Olight Javelot Turbo 2 1500 meter beam" loading="lazy" width="1400" height="933">
      <span>Conquer the Night <b>Javelot Turbo 2 →</b></span>
    </a>
    <a class="eus-olight-gallery-card" href="/products/olight-javelot-turbo-2-1-800-lumen-long-range-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/08_Javelot_Turbo_2_Handheld_b4335b54-f0cc-49db-a83a-b5865eb0e3b4.jpg?v=1790101953&width=900" alt="Olight Javelot Turbo 2 handheld" loading="lazy" width="900" height="600">
      <span>Long-Range Control <b>Javelot Turbo 2 →</b></span>
    </a>
    <a class="eus-olight-gallery-card" href="/products/olight-osight-r-enclosed-red-dot-sight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/olight-osight-r-lifestyle-mounted-optic.jpg?v=1790121568&width=900" alt="Olight OSIGHT R mounted outdoors" loading="lazy" width="900" height="600">
      <span>Find Your Focus <b>OSIGHT R →</b></span>
    </a>
    <a class="eus-olight-gallery-card" href="/products/olight-osight-r-enclosed-red-dot-sight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/02_OSIGHT_R_Field_Closeup_c40670e5-fdc6-4e80-be75-59fa91cdd608.jpg?v=1790122780&width=900" alt="Olight OSIGHT R field close-up" loading="lazy" width="900" height="600">
      <span>Built for Visibility <b>OSIGHT R →</b></span>
    </a>
    <a class="eus-olight-gallery-card eus-olight-gallery-card--wide" href="/products/olight-osight-r-enclosed-red-dot-sight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/11_OSIGHT_R_Ready_When_It_Matters_b7f8b790-a3d6-4862-858a-77b0e140a2cd.jpg?v=1790110309&width=1400" alt="Olight OSIGHT R Ready When It Matters feature" loading="lazy" width="1400" height="933">
      <span>Ready When It Matters <b>OSIGHT R →</b></span>
    </a>
    <a class="eus-olight-gallery-card" href="/products/olight-warrior-ultra-2-500-lumen-rechargeable-flashlight">
      <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/2R8A9785_80be1376-5bb9-4cb2-ae4c-6f9a6a247aab.jpg?v=1790107802&width=900" alt="Olight Warrior Ultra in three colors" loading="lazy" width="900" height="600">
      <span>Choose Your Light <b>Warrior Ultra →</b></span>
