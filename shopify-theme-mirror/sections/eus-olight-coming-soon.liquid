  <div class="eus-olight-destination__shop-intro page-width" id="olight-products">
    <span class="eus-olight-destination__eyebrow">SHOP OLIGHT AT ELEVATION</span>
    <h2>{% if is_tactical %}Tactical &amp; Professional Products{% else %}Featured Olight Products{% endif %}</h2>
    <p>Official Olight products with Elevation UpScales retailer support.</p>
  </div>
</section>

<style>
body:has(.eus-olight-destination) .shopify-section:has(.eus-olight-destination) + .shopify-section{display:none}
.eus-olight-destination{background:#05080b;color:#fff;padding-bottom:20px}
.eus-olight-destination__hero{position:relative;min-height:660px;display:flex;align-items:flex-end;overflow:hidden;background:#05080b}
.eus-olight-destination__hero>img,.eus-olight-destination__hero>video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
.eus-olight-destination__hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,7,10,.95) 0%,rgba(3,7,10,.72) 40%,rgba(3,7,10,.2) 72%,rgba(3,7,10,.03) 100%),linear-gradient(0deg,rgba(3,7,10,.75),transparent 52%)}
.eus-olight-destination__hero-copy{position:relative;z-index:2;width:100%;padding-top:110px;padding-bottom:78px}
.eus-olight-destination__eyebrow{display:inline-block;margin-bottom:14px;color:#58d4f4;font-size:.72rem;font-weight:850;letter-spacing:.18em;text-transform:uppercase}
.eus-olight-destination h1{max-width:760px;margin:0 0 18px;font-size:clamp(3rem,6vw,6.2rem);line-height:.92;letter-spacing:-.055em;color:#fff}
.eus-olight-destination__hero-copy p{max-width:720px;margin:0;color:#d8e1e7;font-size:1.08rem;line-height:1.65}
.eus-olight-destination__actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.eus-olight-destination__button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 22px;border:1px solid rgba(255,255,255,.48);border-radius:9px;color:#fff;text-decoration:none;font-weight:800}
.eus-olight-destination__button--primary{background:#fff;color:#071018;border-color:#fff}
.eus-olight-destination__trust{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#22313a;border:1px solid #22313a;margin-top:0}
.eus-olight-destination__trust>div{background:#091017;padding:24px}
.eus-olight-destination__trust strong,.eus-olight-destination__trust span{display:block}
.eus-olight-destination__trust strong{font-size:1rem;margin-bottom:6px}
.eus-olight-destination__trust span{color:#9eafb9;font-size:.9rem;line-height:1.45}
.eus-olight-destination__intro,.eus-olight-destination__gallery-head{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:end;padding-top:72px;padding-bottom:30px}
.eus-olight-destination__intro h2,.eus-olight-destination__gallery-head h2,.eus-olight-destination__shop-intro h2{margin:0;color:#fff;font-size:clamp(2.2rem,4.6vw,4.6rem);line-height:.98;letter-spacing:-.045em}
.eus-olight-destination__intro p,.eus-olight-destination__gallery-head p,.eus-olight-destination__shop-intro p{margin:0;color:#aebbc4;line-height:1.65}
.eus-olight-destination__paths{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.eus-olight-path{position:relative;display:block;min-height:390px;border-radius:18px;overflow:hidden;color:#fff;text-decoration:none;background:#0b1218}
.eus-olight-path img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}
.eus-olight-path:hover img{transform:scale(1.025)}
.eus-olight-path__shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(3,7,10,.92),rgba(3,7,10,.12) 68%)}
.eus-olight-path__copy{position:absolute;inset:auto 22px 22px;z-index:2}
.eus-olight-path__copy small,.eus-olight-path__copy strong,.eus-olight-path__copy em{display:block}
