<script>
  (() => {
    const root = document.querySelector('[data-emh-carousel]');
    if (!root) return;
    const track = root.querySelector('[data-emh-track]');
    const prev = root.querySelector('[data-emh-prev]');
    const next = root.querySelector('[data-emh-next]');
    if (!track) return;
    const step = () => Math.max(280, Math.round(track.clientWidth * 0.88));
    if (prev) prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  })();
</script>

