        </div>
      </div>

      <div class="emh-featured-sok__track" data-emh-track tabindex="0" aria-label="Featured Olight products">
        {% for product in core_lineup.products limit: 8 %}
          {% if product != blank and product.available %}
            {% assign v = product.selected_or_first_available_variant %}
