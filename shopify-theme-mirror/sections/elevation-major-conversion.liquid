                      <button type="submit" name="checkout" class="emh-buy-now">Buy now</button>
                    {% endform %}
                  {% endif %}
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
      <div class="emh-featured-sok__footer">
        <a class="emh-featured-sok__all" href="/collections/olight">View all Olight →</a>
        <span>Swipe or use the arrows to browse.</span>
      </div>
    </div>
  </section>

