              <a class="emh-featured-card__media" href="{{ product.url }}">
                <span class="emh-featured-card__fallback" aria-hidden="true">OLIGHT</span>
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 620px) 82vw, (max-width: 1000px) 44vw, 31vw', alt: product.title, class: 'emh-featured-card__image' }}
                {% endif %}
                {% if product.vendor == 'Olight' %}
                  <span class="emh-featured-card__badge">OLIGHT</span>
                {% endif %}
              </a>
              <div class="emh-featured-card__copy">
                <p class="emh-vendor">{{ product.vendor }}</p>
                <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <div class="emh-featured-card__price">{{ product.price | money }}</div>
                <div class="emh-featured-card__actions">
                  <a class="emh-btn emh-btn--product" href="{{ product.url }}">Details</a>
