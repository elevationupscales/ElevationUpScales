{% assign sys51 = all_products['sok-51-2kwh-48v-server-rack-battery-system'] %}

<section class="sok-exec">
  <a class="sok-exec__hero" href="#find-your-sok">
    <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk48v100n-application.jpg?v=1790190330" alt="SOK rack battery energy storage application" loading="eager" fetchpriority="high">
    <span class="sok-exec__hero-shade"></span>
    <span class="sok-exec__hero-copy">
      <small>AUTHORIZED SOK DEALER</small>
      <strong>SOK Energy</strong>
      <em>Backup power, emergency readiness, RV, marine, off-grid independence and scalable rack storage.</em>
      <b>Explore SOK →</b>
    </span>
  </a>

  <div class="sok-exec__page">
    <section class="sok-story">
      <div class="sok-story__copy">
        <p>BACKUP POWER • EMERGENCY READINESS</p>
        <h2>Power Beyond Limits.</h2>
        <span>Reliable backup power starts with the right battery system. SOK gives us a flexible lithium platform for emergency readiness — from compact 12V and 24V systems for essential loads to scalable 48V rack storage for larger backup and whole-home applications.</span>
      </div>
      <div class="sok-story__media">
        <img class="sok-story__media-main sok-story__product" src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk12v100pc-main.png?v=1788791577" alt="SOK SK12V100PC 12V 100Ah LiFePO4 battery" loading="lazy">
        <img class="sok-story__product" src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk24v150ph-clean.png?v=1789716995" alt="SOK SK24V150PH 24V 150Ah heated LiFePO4 battery" loading="lazy">
      </div>
    </section>

    <section class="sok-use" id="find-your-sok">
      <div class="sok-use__head">
        <p>FIND YOUR SOK</p>
        <h2>Backup Power. The way you need it.</h2>
        <span>From whole-home storage to compact 12V power, start with the system that matches how you actually use energy.</span>
      </div>
      <div class="sok-use__grid">
        <a href="#sok-48v-storage" class="sok-use__tile sok-use__tile--product">
          <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk48v100n-official-clean.png?v=1789867193" alt="SOK SK48V100N 51.2V rack battery" loading="lazy">
          <span><small>WHOLE HOME • BACKUP</small><strong>Whole Home Backup</strong><em>Compare scalable 48V storage systems →</em></span>
        </a>
        <a href="{{ sk24p.url }}" class="sok-use__tile sok-use__tile--product">
          <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk24v150ph-official.png?v=1788889870" alt="SOK SK24V150PH 24V 150Ah heated LiFePO4 battery" loading="lazy">
          <span><small>OFF-GRID • CABIN • SOLAR</small><strong>24V Systems</strong><em>Explore premium 24V battery systems →</em></span>
        </a>
        <a href="{{ sk206ph.url }}" class="sok-use__tile sok-use__tile--product">
          <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk12v206ph-official-front-2026-09-20.jpg?v=1789929671" alt="SOK SK12V206PH marine-grade 12V 206Ah heated LiFePO4 battery" loading="lazy">
          <span><small>RV • MARINE</small><strong>RV &amp; Marine</strong><em>Explore heated and marine-ready batteries →</em></span>
        </a>
        <a href="{{ sk12.url }}" class="sok-use__tile sok-use__tile--product">
          <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk12v100pc-standalone-isolated-2026-09-19.png?v=1790190768" alt="SOK SK12V100PC compact 12V 100Ah Bluetooth LiFePO4 battery" loading="lazy">
          <span><small>HOBBY • MOBILE • AUXILIARY</small><strong>Hobby &amp; Mobile Power</strong><em>Start with compact 12V lithium →</em></span>
        </a>
      </div>
    </section>

    <section class="sok-feature sok-feature--light">
      <div class="sok-feature__media sok-feature__media--product">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk12v100pc-standalone-isolated-2026-09-19.png?v=1790190768" alt="SOK SK12V100PC 12V 100Ah Bluetooth LiFePO4 battery" loading="lazy">
      </div>
      <div class="sok-feature__copy">
        <small>12V • 100AH • BLUETOOTH</small>
        <h2>SK12V100PC</h2>
        <p>The compact SOK starting point for RV, van, marine and auxiliary-power systems. Group 24 sizing keeps it familiar while Bluetooth monitoring adds modern visibility.</p>
        <div class="sok-feature__actions sok-feature__actions--commerce">
          <span class="sok-feature__price">{{ sk12.price | money }}</span>
          {% if sk12.available and sk12.has_only_default_variant %}
            {% assign sok_buy_v = sk12.selected_or_first_available_variant %}
            {% form 'product', sk12, class: 'sok-feature__buy-form' %}
              <input type="hidden" name="id" value="{{ sok_buy_v.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" name="checkout" class="sok-feature__buy-now">Buy now</button>
            {% endform %}
          {% else %}
            <a class="sok-feature__buy-now" href="{{ sk12.url }}">Choose options</a>
          {% endif %}
          <a class="sok-feature__details" href="{{ sk12.url }}">View details</a>
        </div>
      </div>
    </section>

    <section class="sok-feature sok-feature--dark sok-feature--reverse">
      <div class="sok-feature__media sok-feature__media--product">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk12v206h-standalone-isolated-2026-09-19.jpg?v=1790190739" alt="SOK SK12V206H 12V 206Ah heated LiFePO4 battery" loading="lazy">
      </div>
      <div class="sok-feature__copy">
        <small>12V • 206AH • HEATED</small>
        <h2>SK12V206H</h2>
