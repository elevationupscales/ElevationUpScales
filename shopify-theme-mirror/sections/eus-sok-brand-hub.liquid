    <section class="sok-feature sok-feature--light">
      <div class="sok-feature__media sok-feature__media--product">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk24v150ph-clean.png?v=1789716995" alt="SOK SK24V150PH 24V 150Ah heated LiFePO4 battery" loading="lazy">
      </div>
      <div class="sok-feature__copy">
        <small>24V • 150AH • HEATED • VICTRON CAN</small>
        <h2>SK24V150PH</h2>
        <p>A premium 24V option for customers building beyond entry-level storage. Heating and communications support make it a strong fit for integrated solar and off-grid systems.</p>
        <div class="sok-feature__actions sok-feature__actions--commerce">
          <span class="sok-feature__price">{{ sk24p.price | money }}</span>
          {% if sk24p.available and sk24p.has_only_default_variant %}
            {% assign sok_buy_v = sk24p.selected_or_first_available_variant %}
            {% form 'product', sk24p, class: 'sok-feature__buy-form' %}
              <input type="hidden" name="id" value="{{ sok_buy_v.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" name="checkout" class="sok-feature__buy-now">Buy now</button>
            {% endform %}
          {% else %}
            <a class="sok-feature__buy-now" href="{{ sk24p.url }}">Choose options</a>
          {% endif %}
          <a class="sok-feature__details" href="{{ sk24p.url }}">View details</a>
        </div>
      </div>
    </section>

    <section class="sok-feature sok-feature--dark sok-feature--reverse">
      <div class="sok-feature__media sok-feature__media--product">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk48v100n-standalone-official-front-2026-09-20.jpg?v=1789929543" alt="SOK SK48V100N 51.2V 100Ah 5.12kWh rack battery" loading="lazy">
      </div>
      <div class="sok-feature__copy">
        <small>51.2V • 100AH • 5.12KWH</small>
        <h2>SK48V100N</h2>
        <p>The foundation of our SOK rack-storage lineup. Start with a single 5.12kWh battery or scale into complete cabinet systems as storage needs grow.</p>
        <div class="sok-feature__actions sok-feature__actions--commerce">
          <span class="sok-feature__price">{{ sk48.price | money }}</span>
          {% if sk48.available and sk48.has_only_default_variant %}
            {% assign sok_buy_v = sk48.selected_or_first_available_variant %}
            {% form 'product', sk48, class: 'sok-feature__buy-form' %}
              <input type="hidden" name="id" value="{{ sok_buy_v.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" name="checkout" class="sok-feature__buy-now">Buy now</button>
            {% endform %}
          {% else %}
            <a class="sok-feature__buy-now" href="{{ sk48.url }}">Choose options</a>
          {% endif %}
          <a class="sok-feature__details" href="{{ sk48.url }}">View details</a>
        </div>
      </div>
    </section>

    <section class="sok-rack-story" id="sok-48v-storage">
      <div class="sok-rack-story__hero">
        <img class="sok-rack-story__cabinet" src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk48v100nbc-30kwh-official-cabinet-2026-09-20.png?v=1789929578" alt="SOK 30.72kWh six-battery rack cabinet system" loading="lazy">
        <span>
          <small>SCALABLE 48V STORAGE</small>
          <strong>Build the rack around your project.</strong>
          <em>Choose an expandable starter configuration or move directly into a full cabinet system.</em>
        </span>
      </div>

      <div class="sok-rack-story__systems">
        <a href="{{ sys20.url }}">
          {% if sys20.featured_media %}{{ sys20.featured_media | image_url: width: 1800 | image_tag: loading: 'lazy', alt: sys20.title }}{% endif %}
          <div><small>EXPANDABLE STARTER</small><strong>20.48kWh</strong><span>4 × SK48V100N in a 6-slot cabinet</span><b>{{ sys20.price | money }}</b><em>Explore system →</em></div>
        </a>
        <a href="{{ sys30.url }}">
          {% if sys30.featured_media %}{{ sys30.featured_media | image_url: width: 1800 | image_tag: loading: 'lazy', alt: sys30.title }}{% endif %}
          <div><small>FULL 6-SLOT CABINET</small><strong>30.72kWh</strong><span>6 × SK48V100N with matching cabinet</span><b>{{ sys30.price | money }}</b><em>Explore system →</em></div>
        </a>
        <a href="{{ sys51.url }}">
          {% if sys51.featured_media %}{{ sys51.featured_media | image_url: width: 1800 | image_tag: loading: 'lazy', alt: sys51.title }}{% endif %}
          <div><small>LARGE STORAGE</small><strong>51.2kWh</strong><span>10 × SK48V100N with 10-battery cabinet</span><b>{{ sys51.price | money }}</b><em>Explore system →</em></div>
        </a>
      </div>
    </section>

    <section class="sok-line">
      <div class="sok-line__head">
        <p>THE SOK BATTERY LINE</p>
        <h2>More ways to build.</h2>
        <span>Explore the core standalone batteries behind the SOK lineup.</span>
      </div>
      <div class="sok-line__rail">
        {% assign core_products = 'sok-sk12v100pc-12v-100ah-lifepo4-battery-group-24|sok-sk12v100h-12v-100ah-heated-lifepo4-battery|sok-sk12v206h-12v-206ah-heated-lifepo4-battery|sok-sk12v206ph-12v-206ah-heated-lifepo4-battery|sok-sk12v280h-12v-280ah-heated-lifepo4-battery|sok-sk12v314ph-12v-314ah-heated-lifepo4-battery|sok-sk24v100-24v-100ah-lifepo4-battery|sok-sk24v150ph-24v-150ah-heated-lifepo4-battery|sok-sk48v100n-51-2v-100ah-5-12kwh-lifepo4-rack-battery' | split: '|' %}
        {% for h in core_products %}
          {% assign p = all_products[h] %}
          {% if p != blank %}
            <a href="{{ p.url }}">
              <div>{% if p.featured_media %}{{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: p.title }}{% endif %}</div>
              <strong>{{ p.title | replace: 'Premium ', '' | truncate: 54 }}</strong>
              <span>{{ p.price | money }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="sok-freight" id="sok-freight">
      <div class="sok-freight__copy">
        <p>DESTINATION-AWARE LITHIUM FREIGHT</p>
        <h2>Hawaii &amp; Alaska Freight Available</h2>
        <span>Elevation helps coordinate SOK lithium orders for destinations that need a more deliberate freight path. We confirm the battery, destination, freight route and delivery method before finalizing the order.</span>
        <div class="sok-freight__actions">
          <a href="/collections/sok-energy-hawaii-freight-options">Hawaii Freight Options →</a>
          <a href="/pages/contact">Start Alaska Freight Order →</a>
        </div>
      </div>
      <div class="sok-freight__media">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk12v100pc-hawaii-3pack-isolated-2026-09-19.png?v=1790190770" alt="Three SOK SK12V100PC batteries prepared as a multi-battery package" loading="lazy">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk24v100-3-pack-hero.jpg?v=1790193971" alt="Three SOK SK24V100 batteries" loading="lazy">
      </div>
    </section>
