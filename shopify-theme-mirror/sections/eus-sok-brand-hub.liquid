.sok-feature__actions--commerce{display:grid;grid-template-columns:auto minmax(140px,220px) minmax(120px,180px);align-items:center;gap:10px}
.sok-feature__buy-form{margin:0}
.sok-feature__buy-now,.sok-feature__details{display:flex;align-items:center;justify-content:center;min-height:46px;padding:11px 15px;border-radius:10px;text-decoration:none;font-weight:900}
.sok-feature__buy-now{border:0;background:#2f624b;color:#fff;cursor:pointer;width:100%}
.sok-feature__details{border:1px solid currentColor;background:transparent;color:inherit}
.sok-feature__actions--commerce a{border-bottom:0!important;padding-bottom:11px!important}
.sok-feature__price{font-weight:900;font-size:1.08rem;opacity:1!important}
@media(max-width:720px){.sok-feature__actions--commerce{grid-template-columns:1fr}.sok-feature__buy-now,.sok-feature__details{width:100%}}
