{% if collection.handle == 'sok-battery' %}
{% assign sk12 = all_products['sok-sk12v100pc-12v-100ah-lifepo4-battery-group-24'] %}
{% assign sk100h = all_products['sok-sk12v100h-12v-100ah-heated-lifepo4-battery'] %}
{% assign sk206h = all_products['sok-sk12v206h-12v-206ah-heated-lifepo4-battery'] %}
{% assign sk206ph = all_products['sok-sk12v206ph-12v-206ah-heated-lifepo4-battery'] %}
{% assign sk280 = all_products['sok-sk12v280h-12v-280ah-heated-lifepo4-battery'] %}
{% assign sk314 = all_products['sok-sk12v314ph-12v-314ah-heated-lifepo4-battery'] %}
