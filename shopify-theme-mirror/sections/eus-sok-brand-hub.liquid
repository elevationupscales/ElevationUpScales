{% stylesheet %}
.sok-exec{background:#071015;color:#f4f8f6}
.sok-exec a{color:inherit;text-decoration:none}
.sok-exec__hero{position:relative;display:block;height:min(78vh,820px);min-height:560px;overflow:hidden;background:#081319}
.sok-exec__hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.sok-exec__hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,10,14,.88) 0%,rgba(3,10,14,.5) 42%,rgba(3,10,14,.12) 75%)}
.sok-exec__hero-copy{position:absolute;left:max(24px,6vw);bottom:max(42px,8vh);display:grid;gap:12px;max-width:720px}
.sok-exec__hero-copy small,.sok-story p,.sok-use__head p,.sok-rack-story__hero small,.sok-line__head p,.sok-freight p{font-size:.7rem;letter-spacing:.17em;font-weight:900;color:#91d8b7;margin:0}
.sok-exec__hero-copy strong{font-size:clamp(4rem,9vw,8.4rem);line-height:.82;letter-spacing:-.06em}
.sok-exec__hero-copy em{font-style:normal;font-size:clamp(1.05rem,2vw,1.4rem);line-height:1.55;color:#d7e2de;max-width:620px}
.sok-exec__hero-copy b{display:inline-flex;width:max-content;margin-top:4px;padding:13px 18px;border:1px solid rgba(255,255,255,.3);border-radius:12px;background:rgba(5,14,19,.74);font-size:.92rem}
.sok-exec__page{width:min(1460px,calc(100% - 40px));margin:auto;padding:90px 0 110px}

.sok-story{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center;margin-bottom:100px}
.sok-story__copy h2,.sok-use__head h2,.sok-line__head h2,.sok-freight h2{margin:10px 0 0;font-size:clamp(2.8rem,5.6vw,5.8rem);line-height:.93;letter-spacing:-.05em}
.sok-story__copy span,.sok-line__head span,.sok-freight__copy>span{display:block;margin-top:22px;color:#a6b7b1;line-height:1.72;font-size:1.05rem}
.sok-story__media{display:grid;grid-template-columns:1.2fr .8fr;gap:12px;align-items:end}
.sok-story__media img{display:block;width:100%;height:100%;border-radius:18px;background:#f4f6f5}
.sok-story__media-main{min-height:520px}
.sok-story__media img:last-child{min-height:390px}
.sok-story__product{object-fit:contain;padding:clamp(18px,3vw,44px);background:#fff!important}
.sok-story__scenario{object-fit:cover}

.sok-use{margin-bottom:100px}
.sok-use__head{max-width:980px;margin-bottom:30px}
.sok-use__head>span{display:block;margin-top:16px;max-width:760px;color:#a6b7b1;line-height:1.65;font-size:1.02rem}
.sok-use__grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.sok-use__tile{position:relative;min-height:470px;border-radius:18px;overflow:hidden;background:#0b171d}
.sok-use__tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.sok-use__tile--product{background:#030506;border:1px solid rgba(255,255,255,.1)}
.sok-use__tile--product img{object-fit:contain;padding:clamp(30px,5vw,72px);background:#030506}
.sok-use__tile--product:nth-child(3) img{padding:clamp(38px,5.5vw,82px);background:#030506}
.sok-use__tile:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(4,12,16,.86),rgba(4,12,16,.06) 65%)}
.sok-use__tile span{position:absolute;left:24px;right:24px;bottom:24px;z-index:1;display:grid;gap:6px}
.sok-use__tile small{font-size:.66rem;letter-spacing:.13em;font-weight:900;color:#a9e1c4}
.sok-use__tile strong{font-size:clamp(1.8rem,3vw,3rem);line-height:1}
.sok-use__tile em{font-style:normal;color:#d2ddd8}

.sok-feature{display:grid;grid-template-columns:1.15fr .85fr;min-height:600px;margin-bottom:18px;border-radius:22px;overflow:hidden}
.sok-feature--reverse{grid-template-columns:.85fr 1.15fr}
.sok-feature--reverse .sok-feature__media{order:2}
.sok-feature--light{background:#edf2ef;color:#0b1714}
.sok-feature--dark{background:#0d1b20;color:#f5f7f6;border:1px solid rgba(255,255,255,.08)}
.sok-feature__media img{width:100%;height:100%;min-height:600px;object-fit:cover}
.sok-feature__media--product{background:#f7f8f7;display:flex;align-items:center;justify-content:center}
.sok-feature__media--product img{object-fit:contain!important;padding:clamp(24px,4vw,64px);background:#fff;max-height:720px}
.sok-feature--dark .sok-feature__media--product{background:#eef2ef}
.sok-feature--light .sok-feature__media img{background:#fff}
.sok-feature__copy{padding:clamp(34px,5vw,74px);display:flex;flex-direction:column;justify-content:center}
.sok-feature__copy small{font-size:.68rem;letter-spacing:.13em;font-weight:900;color:#3b7e5e}
.sok-feature--dark .sok-feature__copy small{color:#91d8b7}
.sok-feature__copy h2{margin:8px 0 16px;font-size:clamp(3rem,6vw,6.3rem);line-height:.86;letter-spacing:-.06em}
.sok-feature__copy p{margin:0;line-height:1.7;font-size:1.05rem;max-width:580px;color:#49625a}
.sok-feature--dark .sok-feature__copy p{color:#a7b7b1}
.sok-feature__actions{display:flex;align-items:center;gap:18px;margin-top:28px}
.sok-feature__actions a{font-weight:900;border-bottom:1px solid currentColor;padding-bottom:3px}
.sok-feature__actions span{opacity:.78}

.sok-rack-story{margin-top:100px}
.sok-rack-story__hero{position:relative;min-height:620px;border-radius:22px;overflow:hidden}
.sok-rack-story__hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.sok-rack-story__hero .sok-rack-story__cabinet{object-fit:contain;object-position:78% center;padding:clamp(30px,4vw,58px) clamp(24px,5vw,72px) clamp(30px,4vw,58px) 46%;background:#0d1b20}
.sok-rack-story__hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,12,16,.86),rgba(4,12,16,.18))}
.sok-rack-story__hero span{position:absolute;z-index:1;left:clamp(24px,5vw,70px);bottom:clamp(30px,6vw,76px);max-width:700px;display:grid;gap:10px}
.sok-rack-story__hero strong{font-size:clamp(2.8rem,5.6vw,5.8rem);line-height:.92;letter-spacing:-.05em}
.sok-rack-story__hero em{font-style:normal;color:#d7e0dd;line-height:1.55;font-size:1.05rem}
.sok-rack-story__systems{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}
.sok-rack-story__systems>a{background:#0d1b20;border:1px solid rgba(255,255,255,.08);border-radius:18px;overflow:hidden}
.sok-rack-story__systems img{display:block;width:100%;aspect-ratio:1/1;object-fit:contain;background:#f5f7f6}
.sok-rack-story__systems div{padding:24px;display:grid;gap:7px}
.sok-rack-story__systems small{font-size:.66rem;letter-spacing:.12em;font-weight:900;color:#91d8b7}
.sok-rack-story__systems strong{font-size:2rem}
.sok-rack-story__systems span{color:#9fb0aa;line-height:1.45}
.sok-rack-story__systems b{margin-top:8px}
.sok-rack-story__systems em{font-style:normal;font-size:.78rem;font-weight:900;color:#d9eee3}

.sok-line{margin-top:110px}
.sok-line__head{display:grid;grid-template-columns:1fr .8fr;gap:24px;align-items:end;margin-bottom:30px}
.sok-line__head p{grid-column:1/-1}
.sok-line__rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(240px,300px);gap:12px;overflow-x:auto;padding-bottom:12px;scroll-snap-type:x proximity}
.sok-line__rail>a{scroll-snap-align:start;background:#0d1b20;border:1px solid rgba(255,255,255,.08);border-radius:16px;overflow:hidden;padding-bottom:18px}
.sok-line__rail>a>div{background:#f5f7f6}
.sok-line__rail img{width:100%;aspect-ratio:1/1;object-fit:contain;padding:12px}
.sok-line__rail strong,.sok-line__rail span{display:block;padding:0 18px}
.sok-line__rail strong{font-size:1rem;line-height:1.35;margin-top:16px}
.sok-line__rail span{margin-top:7px;color:#91d8b7;font-weight:900}

.sok-freight{margin-top:110px;display:grid;grid-template-columns:1fr .9fr;gap:36px;align-items:center;padding:clamp(30px,5vw,68px);border-radius:22px;background:linear-gradient(135deg,#123126,#0a171c);border:1px solid rgba(255,255,255,.1)}
.sok-freight__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.sok-freight__actions a{display:inline-flex;padding:13px 17px;border-radius:11px;font-weight:900;background:#fff;color:#091412}
.sok-freight__actions a:last-child{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.35)}
.sok-freight__media{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.sok-freight__media img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#fff;border-radius:14px}

@media(max-width:1000px){
  .sok-story,.sok-feature,.sok-feature--reverse,.sok-freight{grid-template-columns:1fr}
  .sok-feature--reverse .sok-feature__media{order:0}
  .sok-feature__media img{min-height:420px}
  .sok-rack-story__systems{grid-template-columns:1fr 1fr}
  .sok-line__head{grid-template-columns:1fr}
}
@media(max-width:700px){
  .sok-exec{overflow-x:hidden}
  .sok-exec__page{width:min(100% - 24px,1460px);padding:58px 0 80px}
  .sok-exec__hero-copy strong{font-size:clamp(3rem,15vw,5.2rem)}
  .sok-story__copy h2,.sok-use__head h2,.sok-line__head h2,.sok-freight h2{font-size:clamp(2.35rem,11.5vw,4.2rem)}
  .sok-feature__copy h2{font-size:clamp(2.2rem,11vw,3.7rem);overflow-wrap:normal}
  .sok-feature__actions{flex-wrap:wrap}
  .sok-freight__actions{display:grid;grid-template-columns:1fr}
  .sok-freight__actions a{min-height:48px;align-items:center;justify-content:center;text-align:center}
  .sok-line__rail{max-width:100%;overscroll-behavior-inline:contain}
  .sok-rack-story__hero .sok-rack-story__cabinet{padding:28px 18px 190px;object-position:center top}
  .sok-exec__hero{min-height:600px}
  .sok-exec__hero-copy{left:22px;right:22px;bottom:30px}
  .sok-story{gap:26px;margin-bottom:70px}
  .sok-story__media{grid-template-columns:1fr}
  .sok-story__media-main,.sok-story__media img:last-child{min-height:300px}
  .sok-use__grid{grid-template-columns:1fr}
  .sok-use__tile{min-height:390px}
  .sok-feature{min-height:0}
  .sok-feature__media img{min-height:340px}
  .sok-feature__copy{padding:30px 24px 36px}
  .sok-rack-story__hero{min-height:520px}
  .sok-rack-story__systems{grid-template-columns:1fr}
  .sok-freight__media{grid-template-columns:1fr 1fr}
}
{% endstylesheet %}

<style>
