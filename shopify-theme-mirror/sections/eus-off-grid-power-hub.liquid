{% if collection.handle == 'off-grid-power' %}
<section class="eus-offgrid" aria-label="Off-Grid Power collection">
  <div class="eus-offgrid__hero">
    <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk48v100n-application.jpg?v=1790190330" alt="Off-grid lithium battery energy storage system" loading="eager" fetchpriority="high" width="2200" height="1200">
    <div class="eus-offgrid__shade"></div>
    <div class="eus-offgrid__hero-copy">
      <span>BATTERY · SOLAR · CHARGING · BACKUP · MOBILE</span>
      <h1>Build off-grid power without the dead ends.</h1>
      <p>Start with the job you need the system to do, then move into collections that actually have current products available.</p>
      <div class="eus-offgrid__hero-actions">
        <a href="#offgrid-paths">Choose a power path</a>
        <a href="/collections/complete-power-systems">Complete systems</a>
        <a href="/pages/contact">Get system help</a>
      </div>
    </div>
  </div>

  <div class="eus-offgrid__trust">
    <div><strong>Lithium Storage</strong><span>12V, 24V and 48V power</span></div>
    <div><strong>Solar & Charging</strong><span>Panels, controllers and charging</span></div>
    <div><strong>Backup & Mobile</strong><span>Home, RV and remote-use paths</span></div>
    <div><strong>System Support</strong><span>Help before checkout</span></div>
  </div>

  <div class="eus-offgrid__intro" id="offgrid-paths">
    <div>
      <span class="eus-offgrid__eyebrow">START WITH THE APPLICATION</span>
      <h2>Choose the system lane that matches the job.</h2>
    </div>
    <p>The previous catalog structure exposed categories that could lead into draft-only or nearly empty destinations. This hub keeps the top-level navigation focused on paths with current sellable products.</p>
  </div>

  <div class="eus-offgrid__path-grid">
    <a href="/collections/lithium-batteries"><small>ENERGY STORAGE</small><strong>Lithium Batteries</strong><span>Current 12V, 24V and 48V lithium options →</span></a>
    <a href="/collections/solar-charging"><small>ENERGY INPUT</small><strong>Solar &amp; Charging</strong><span>Panels, charge controllers, inverters and maintainers →</span></a>
    <a href="/collections/charge-controllers-dc-dc-charging"><small>CHARGE CONTROL</small><strong>Controllers &amp; DC-DC</strong><span>Manage solar and alternator charging →</span></a>
    <a href="/collections/battery-charging-monitoring"><small>MONITORING</small><strong>Charging &amp; Monitoring</strong><span>Battery charging, shunts and system visibility →</span></a>
    <a href="/collections/rv-mobile-power"><small>MOBILE POWER</small><strong>RV &amp; Mobile Power</strong><span>Power equipment for RV, van and mobile builds →</span></a>
    <a href="/collections/home-backup"><small>RESILIENCE</small><strong>Home Backup</strong><span>Backup-power products for essential loads →</span></a>
    <a href="/collections/off-grid-heat"><small>REMOTE COMFORT</small><strong>Off-Grid Heat</strong><span>Heat-and-power solutions for remote use →</span></a>
    <a href="/collections/hawaii-remote-power"><small>REMOTE DESTINATIONS</small><strong>Hawaii &amp; Remote Power</strong><span>Products already organized for remote-market workflows →</span></a>
  </div>

  <section class="eus-offgrid__systems">
    <div class="eus-offgrid__systems-head">
      <span class="eus-offgrid__eyebrow">SKIP THE COMPONENT HUNT</span>
      <h2>Start with a complete system.</h2>
      <p>If you already know you need a packaged power solution, use the complete-system lane instead of piecing together a system from disconnected categories.</p>
    </div>
    <div class="eus-offgrid__system-cards">
      <a href="/collections/complete-power-systems">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/sok-sk48v100nbc-30kwh-official-cabinet-2026-09-20.png?v=1789929578" alt="Complete SOK rack battery system" loading="lazy" width="1200" height="1200">
        <span><small>COMPLETE POWER</small><strong>Complete Power Systems</strong><em>Shop packaged systems →</em></span>
      </a>
      <a href="/products/elevation-basic-off-grid-heat-kit-vevor-8kw-diesel-heater-sok-100ah-battery-20a-charger">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/basic-off-grid-heat-kit-hero.png?v=1789871015" alt="Elevation off-grid heat and power kit" loading="lazy" width="1200" height="1200">
        <span><small>OFF-GRID HEAT + POWER</small><strong>Elevation Off-Grid Heat Kit</strong><em>View active system →</em></span>
      </a>
      <a href="/products/renogy-100w-12v-n-type-portable-solar-suitcase-kit-with-20a-voyager-controller">
        <img src="https://cdn.shopify.com/s/files/1/1035/5353/2273/files/renogy-rng-kit-stcs100dc-voy20-g1-us-main_d4f77b81-47b3-460a-977f-88c84ba81fa6.jpg?v=1789870861" alt="Renogy portable solar suitcase kit" loading="lazy" width="1200" height="1200">
        <span><small>PORTABLE SOLAR</small><strong>Renogy 100W Solar Kit</strong><em>View active kit →</em></span>
      </a>
    </div>
  </section>

  <section class="eus-offgrid__brands">
    <div>
      <span class="eus-offgrid__eyebrow">SHOP BY CORE BRAND</span>
      <h2>Go directly to the platform you are building around.</h2>
    </div>
    <div class="eus-offgrid__brand-links">
      <a href="/collections/sok-battery"><strong>SOK Energy</strong><span>Lithium batteries and scalable storage →</span></a>
      <a href="/collections/renogy"><strong>Renogy</strong><span>Solar, charging and mobile power →</span></a>
      <a href="/collections/sungoldpower"><strong>SunGoldPower</strong><span>Inverter chargers and larger solar systems →</span></a>
    </div>
  </section>

  <section class="eus-offgrid__help">
    <div>
      <span class="eus-offgrid__eyebrow">NOT SURE WHICH PATH?</span>
      <h2>Tell us what you need to power.</h2>
      <p>We can help narrow battery capacity, charging, inverter and freight requirements before you check out.</p>
    </div>
    <div class="eus-offgrid__help-actions">
      <a href="/pages/contact">Contact Us</a>
      <a href="/collections/hawaii-remote-power">Remote / Hawaii Power</a>
    </div>
  </section>
</section>

<style>
#shopify-section-{{ section.id }} ~ [id$="__section"]{display:none}
.eus-offgrid{background:#f4f6f5;color:#0f2135}
.eus-offgrid__hero{position:relative;min-height:650px;display:flex;align-items:flex-end;overflow:hidden;background:#071015}
.eus-offgrid__hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.eus-offgrid__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,12,16,.94),rgba(4,12,16,.5) 56%,rgba(4,12,16,.12)),linear-gradient(0deg,rgba(4,12,16,.8),transparent 58%)}
.eus-offgrid__hero-copy{position:relative;z-index:2;width:min(100% - 40px,1240px);margin:0 auto;padding:96px 0 64px;color:#fff}
.eus-offgrid__hero-copy>span,.eus-offgrid__eyebrow{color:#91d8b7;font-size:.72rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
.eus-offgrid__hero h1{margin:9px 0 16px;font-size:clamp(3.4rem,8.5vw,7.4rem);line-height:.88;letter-spacing:-.06em;color:#fff;max-width:950px}
.eus-offgrid__hero p{max-width:720px;color:#d7e2de;font-size:1.05rem;line-height:1.65;margin:0}
.eus-offgrid__hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:26px}.eus-offgrid__hero-actions a{display:inline-flex;min-height:47px;align-items:center;padding:0 18px;border-radius:10px;background:#fff;color:#091412;text-decoration:none;font-weight:900}.eus-offgrid__hero-actions a+ a{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.4)}
.eus-offgrid__trust{display:grid;grid-template-columns:repeat(4,1fr);background:#0e1b20;color:#fff}.eus-offgrid__trust div{padding:22px 24px;border-right:1px solid rgba(255,255,255,.1)}.eus-offgrid__trust div:last-child{border-right:0}.eus-offgrid__trust strong,.eus-offgrid__trust span{display:block}.eus-offgrid__trust strong{font-size:.9rem}.eus-offgrid__trust span{margin-top:4px;color:#9fb0aa;font-size:.76rem}
.eus-offgrid__intro,.eus-offgrid__systems,.eus-offgrid__brands,.eus-offgrid__help{width:min(100% - 40px,1240px);margin:0 auto}
.eus-offgrid__intro{padding:86px 0 44px;display:grid;grid-template-columns:.9fr 1.1fr;gap:46px;align-items:center}.eus-offgrid__intro h2,.eus-offgrid__systems h2,.eus-offgrid__brands h2,.eus-offgrid__help h2{margin:8px 0 12px;font-size:clamp(2.2rem,5vw,4.6rem);line-height:.96;letter-spacing:-.05em}.eus-offgrid__intro p,.eus-offgrid__systems p,.eus-offgrid__help p{margin:0;color:#61717b;line-height:1.65}
.eus-offgrid__path-grid{width:min(100% - 40px,1240px);margin:0 auto 88px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.eus-offgrid__path-grid a{min-height:190px;padding:24px;border-radius:18px;background:#fff;border:1px solid #dce3df;color:#0f2135;text-decoration:none;display:flex;flex-direction:column;justify-content:flex-end;transition:transform .2s ease,box-shadow .2s ease}.eus-offgrid__path-grid a:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(15,33,53,.09)}.eus-offgrid__path-grid small{font-size:.63rem;letter-spacing:.14em;font-weight:900;color:#367557}.eus-offgrid__path-grid strong{margin:7px 0 6px;font-size:1.3rem}.eus-offgrid__path-grid span{font-size:.82rem;color:#66747b;line-height:1.45}
.eus-offgrid__systems{padding:72px 0;border-top:1px solid #d7dfdb}.eus-offgrid__systems-head{max-width:820px;margin-bottom:28px}.eus-offgrid__system-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.eus-offgrid__system-cards a{position:relative;min-height:420px;border-radius:20px;overflow:hidden;background:#0b171d;color:#fff;text-decoration:none}.eus-offgrid__system-cards img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#fff}.eus-offgrid__system-cards a:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(4,12,16,.9),rgba(4,12,16,.05) 62%)}.eus-offgrid__system-cards span{position:absolute;z-index:2;left:22px;right:22px;bottom:22px;display:flex;flex-direction:column}.eus-offgrid__system-cards small{font-size:.63rem;letter-spacing:.14em;font-weight:900;color:#a9e1c4}.eus-offgrid__system-cards strong{font-size:1.4rem;margin:7px 0}.eus-offgrid__system-cards em{font-style:normal;color:#d7e2de;font-size:.82rem}
.eus-offgrid__brands{padding:72px 0;border-top:1px solid #d7dfdb;display:grid;grid-template-columns:.8fr 1.2fr;gap:48px}.eus-offgrid__brand-links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.eus-offgrid__brand-links a{padding:26px;border-radius:18px;background:#0f2135;color:#fff;text-decoration:none}.eus-offgrid__brand-links strong,.eus-offgrid__brand-links span{display:block}.eus-offgrid__brand-links strong{font-size:1.35rem}.eus-offgrid__brand-links span{margin-top:8px;color:#b7c4cb;font-size:.82rem;line-height:1.5}
.eus-offgrid__help{margin-bottom:72px;padding:34px;border-radius:22px;background:linear-gradient(135deg,#123126,#0f2135);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:32px}.eus-offgrid__help h2{color:#fff}.eus-offgrid__help p{color:#c0cbc7}.eus-offgrid__help-actions{display:flex;gap:9px;flex-wrap:wrap}.eus-offgrid__help-actions a{display:inline-flex;min-height:47px;align-items:center;padding:0 18px;border-radius:10px;background:#fff;color:#0f2135;text-decoration:none;font-weight:900}.eus-offgrid__help-actions a+ a{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.35)}
@media(max-width:1000px){.eus-offgrid__path-grid{grid-template-columns:repeat(2,1fr)}.eus-offgrid__system-cards{grid-template-columns:1fr}.eus-offgrid__brands{grid-template-columns:1fr}.eus-offgrid__brand-links{grid-template-columns:1fr}.eus-offgrid__help{align-items:flex-start;flex-direction:column}}
@media(max-width:700px){.eus-offgrid__hero{min-height:540px}.eus-offgrid__hero-copy,.eus-offgrid__intro,.eus-offgrid__path-grid,.eus-offgrid__systems,.eus-offgrid__brands,.eus-offgrid__help{width:min(100% - 28px,1240px)}.eus-offgrid__trust{grid-template-columns:repeat(2,1fr)}.eus-offgrid__trust div:nth-child(2){border-right:0}.eus-offgrid__trust div:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.1)}.eus-offgrid__intro{grid-template-columns:1fr}.eus-offgrid__path-grid{grid-template-columns:1fr}}
</style>
{% endif %}

